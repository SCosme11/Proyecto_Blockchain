# Copy to .env (in this folder or backend/) and adjust. Real environment variables take precedence.

# --- PostgreSQL connection (the database is created automatically if it does not exist) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=ai_ledger
PGUSER=postgres
PGPASSWORD=changeme
PGSSLMODE=prefer

# --- C++ node ---
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
# Paths are relative to the directory the server is started from (backend/).
RULES_PATH=rules/confidence_rules.json
SCHEMA_PATH=../db/schema.sql
FRONTEND_DIST=../frontend/dist

# --- Consensus / mining ---
# Proof-of-work target: number of leading zero BITS in the block hash (each +1 doubles the work).
DEFAULT_DIFFICULTY_BITS=20
MAX_TX_PER_BLOCK=10
MAX_MINERS=16

# Max allowed difference between the reviewer's signing time and the node clock.
TIMESTAMP_SKEW_SECONDS=300
