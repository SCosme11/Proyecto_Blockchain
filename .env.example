# Copy to .env (in this folder or backend/) and adjust. Real environment variables take precedence.

# --- PostgreSQL connection (the database is created automatically if it does not exist) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=ai_ledger
PGUSER=postgres
PGPASSWORD=changeme
PGSSLMODE=prefer

# --- C++ node ---
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
# Paths are relative to the directory the server is started from (backend/).
RULES_PATH=rules/confidence_rules.json
SCHEMA_PATH=../db/schema.sql
FRONTEND_DIST=../frontend/dist

# --- Consensus (PoW and PoS, selectable per round) ---
# Stake a newly-created node starts with (PoS weight; not spendable/transferable).
INITIAL_STAKE=100
MAX_TX_PER_BLOCK=10
# Rewards and punishment (all counters, never transferable currency):
BLOCK_REWARD=10      # PoW: credited to the miner's balance once the block has 6 confirmations
POS_REWARD=5         # PoS: credited to the proposer's balance when its block is accepted
TX_VALUE=10          # "value" of one transaction; punishment rule B takes min(a_p, alpha * tx_count * TX_VALUE)
# Pause (ms) on the APUESTAS/SORTEO/CANDIDATO PoS phases so the UI can show them. 0 = no pause.
PHASE_DELAY_MS=250
# Default seed for the round's reproducible randomness (validator subset, vote delays).
# 0 = a fresh random seed per round; a round can always override it with {"seed": N}.
SEED=0
# Node count (10-20) and PoW difficulty (1-6 hex zero digits) are fixed by the assignment
# guide and validated in api.cpp, not configurable here.

# Max allowed difference between the reviewer's signing time and the node clock.
TIMESTAMP_SKEW_SECONDS=300
